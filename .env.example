# Copy to .env.local and fill in once confirmed by the school.

# Public website URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Exact school location: Google Maps -> Share -> "Embed a map" -> copy the src="..." URL
# (Until set, the map shows the town of Bhadrak only.)
NEXT_PUBLIC_MAP_EMBED_URL=

# Google Maps share link of the exact school location, for the "Get Directions" button
NEXT_PUBLIC_MAPS_DIRECTIONS_URL=
